<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3002</defaultcontrol>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <controls>
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" tween="cubic" easing="out"/>
                <effect type="slide" start="0,24" end="0,0" tween="cubic" easing="out" time="340"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="200" tween="cubic" easing="in"/>
                <effect type="slide" start="0,0" end="0,16" tween="cubic" easing="in" time="220"/>
            </animation>
            <control type="group">
                <right>64</right>
                <bottom>230</bottom>
                <width>370</width>
                <height>82</height>

                <!-- Shadow -->
                <control type="image">
                    <left>-28</left>
                    <top>-26</top>
                    <width>426</width>
                    <height>128</height>
                    <texture border="60" colordiffuse="55000000">skip-marker-shadow.png</texture>
                </control>
                <!-- Background pill -->
                <control type="image">
                    <width>370</width>
                    <height>82</height>
                    <texture border="12" colordiffuse="EE121316">skip-marker-pill.png</texture>
                </control>
                <!-- Countdown fill (frame-swap: 1001 prerendered gradient frames) -->
                <control type="image">
                    <width>370</width>
                    <height>82</height>
                    <texture colordiffuse="FFE5A00D">$INFO[Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_frame),skip-marker-progress/,.png]</texture>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_frame))</visible>
                </control>
                <!-- Countdown seconds badge -->
                <control type="image">
                    <right>18</right>
                    <top>21</top>
                    <width>50</width>
                    <height>40</height>
                    <texture border="10" colordiffuse="33FFFFFF">skip-marker-pill.png</texture>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining))</visible>
                </control>
                <control type="label">
                    <right>18</right>
                    <top>21</top>
                    <width>50</width>
                    <height>40</height>
                    <label>$INFO[Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining),,s]</label>
                    <font>font20_title</font>
                    <textcolor>FFE5A00D</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>center</align>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining))</visible>
                </control>
                <!-- Button (invisible, covers full pill) -->
                <control type="button" id="3002">
                    <width>370</width>
                    <height>82</height>
                    <label></label>
                    <texturefocus colordiffuse="00FFFFFF">white.png</texturefocus>
                    <texturenofocus colordiffuse="00FFFFFF">white.png</texturenofocus>
                    <alttexturefocus colordiffuse="00FFFFFF">white.png</alttexturefocus>
                    <alttexturenofocus colordiffuse="00FFFFFF">white.png</alttexturenofocus>
                </control>
                <!-- Label (unfocused) -->
                <control type="label">
                    <left>26</left>
                    <top>13</top>
                    <width>240</width>
                    <height>48</height>
                    <label>$INFO[Window.Property(marker_message)]</label>
                    <font>font20_title</font>
                    <textcolor>F2FFFFFF</textcolor>
                    <shadowcolor>CC000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>left</align>
                    <visible>!Control.HasFocus(3002)</visible>
                </control>
                <!-- Label (focused) -->
                <control type="label">
                    <left>26</left>
                    <top>13</top>
                    <width>240</width>
                    <height>48</height>
                    <label>$INFO[Window.Property(marker_message)]</label>
                    <font>font20_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>CC000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>left</align>
                    <visible>Control.HasFocus(3002)</visible>
                </control>
            </control>
        </control>
    </controls>
</window>
