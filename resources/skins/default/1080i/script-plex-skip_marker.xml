<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3002</defaultcontrol>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <controls>
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="220"/>
                <effect type="slide" start="0,28" end="0,0" tween="cubic" easing="out" time="260"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="160"/>
                <effect type="slide" start="0,0" end="0,20" tween="cubic" easing="in" time="180"/>
            </animation>
            <control type="group">
                <right>64</right>
                <bottom>230</bottom>
                <width>450</width>
                <height>92</height>

                <control type="image">
                    <left>-38</left>
                    <top>-34</top>
                    <width>526</width>
                    <height>154</height>
                    <texture border="76" colordiffuse="88000000">skip-marker-shadow.png</texture>
                </control>
                <control type="image">
                    <width>450</width>
                    <height>82</height>
                    <texture border="12" colordiffuse="EE121316">skip-marker-pill.png</texture>
                </control>
                <control type="image">
                    <width>450</width>
                    <height>82</height>
                    <texture colordiffuse="FFE5A00D">$INFO[Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_frame),skip-marker-progress/,.png]</texture>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_frame))</visible>
                </control>
                <control type="image">
                    <width>450</width>
                    <height>82</height>
                    <texture border="12" colordiffuse="44FFFFFF">skip-marker-outline.png</texture>
                    <visible>!Control.HasFocus(3002)</visible>
                </control>
                <control type="image">
                    <width>450</width>
                    <height>82</height>
                    <texture border="12" colordiffuse="DDE5A00D">skip-marker-outline.png</texture>
                    <visible>Control.HasFocus(3002)</visible>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>13</top>
                    <width>308</width>
                    <height>48</height>
                    <label>$INFO[Window.Property(marker_message)]</label>
                    <font>font20_title</font>
                    <textcolor>F2FFFFFF</textcolor>
                    <shadowcolor>CC000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>left</align>
                    <visible>!Control.HasFocus(3002)</visible>
                </control>
                <control type="image">
                    <right>26</right>
                    <top>21</top>
                    <width>62</width>
                    <height>40</height>
                    <texture border="12" colordiffuse="24FFFFFF">skip-marker-pill.png</texture>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining))</visible>
                </control>
                <control type="label">
                    <right>26</right>
                    <top>21</top>
                    <width>62</width>
                    <height>40</height>
                    <label>$INFO[Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining),,s]</label>
                    <font>font20_title</font>
                    <textcolor>FFE5A00D</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>center</align>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining))</visible>
                </control>
                <control type="button" id="3002">
                    <width>450</width>
                    <height>82</height>
                    <label></label>
                    <texturefocus colordiffuse="00FFFFFF">white.png</texturefocus>
                    <texturenofocus colordiffuse="00FFFFFF">white.png</texturenofocus>
                    <alttexturefocus colordiffuse="00FFFFFF">white.png</alttexturefocus>
                    <alttexturenofocus colordiffuse="00FFFFFF">white.png</alttexturenofocus>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>13</top>
                    <width>308</width>
                    <height>48</height>
                    <label>$INFO[Window.Property(marker_message)]</label>
                    <font>font20_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>CC000000</shadowcolor>
                    <aligny>center</aligny>
                    <align>left</align>
                    <visible>Control.HasFocus(3002)</visible>
                </control>
            </control>
        </control>
    </controls>
</window>
