{
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:python3-beta)",
      "Bash(git push origin python3-beta)",
      "Bash(git push -u origin python3-beta)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
